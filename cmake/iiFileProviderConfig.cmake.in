@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/iiFileProviderTargets.cmake")
if(APPLE)
    # Private consumers may build with their install RPATH, and ambient library
    # paths can suppress CMake's inferred build RPATH. Carry the actual package.
    set_property(TARGET iiFileProvider::iiFileProvider APPEND PROPERTY
        INTERFACE_LINK_OPTIONS "LINKER:-rpath,$<TARGET_FILE_DIR:iiFileProvider::iiFileProvider>")
endif()
check_required_components(iiFileProvider)
